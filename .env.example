# Local development only. Replace placeholders before starting the API.
# Existing PostgreSQL volumes keep their original credentials: use those values.
POSTGRES_DB=cloudforge
POSTGRES_USER=cloudforge
POSTGRES_PASSWORD=replace-with-your-local-database-password

# Isolated test database. These credentials are not production secrets.
TEST_POSTGRES_DB=cloudforge_test
TEST_POSTGRES_USER=cloudforge_test
TEST_POSTGRES_PASSWORD=local-test-only

# Generate locally with: openssl rand -hex 32
# Never commit the generated value.
JWT_SECRET=replace-with-a-generated-secret

# Used by Maven/IntelliJ after explicitly loading these variables.
# Compose fixes its API profile to dev; Spring tests select test explicitly.
SPRING_PROFILES_ACTIVE=dev
